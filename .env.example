# Copy to .env (never commit .env). NEXT_PUBLIC_* values end up in the browser bundle: configuration, not secrets.

# Base URL of the TheLink API. Use https:// as soon as the API server has a certificate.
NEXT_PUBLIC_API_URL=http://localhost:5241

# Value of the "api-security-key" header the API expects.
NEXT_PUBLIC_SECURITY_KEY=replace-with-your-api-security-key

# Public address of this site (payment return URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: tenant brand to show (default 1).
# NEXT_PUBLIC_BRAND_ID=1

# Optional, server side only: backend the /api-backend proxy forwards to (defaults to NEXT_PUBLIC_API_URL).
# API_BACKEND_URL=
