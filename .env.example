# Copy to .env (never commit .env).

# --- server only (never sent to the browser) -------------------------------------------------------------
# Address of the TheLink API. Use https:// as soon as the API server has a certificate.
API_BACKEND_URL=http://localhost:5241
# Value of the "api-security-key" header the API expects. The /api-backend proxy adds it; the browser never sees it.
API_SECURITY_KEY=replace-with-your-api-security-key

# --- public (compiled into the browser bundle: settings, not secrets) -------------------------------------
# Public address of this site (payment return URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: tenant brand to show (default 1).
# NEXT_PUBLIC_BRAND_ID=1

# --- Tenant look & feel (read at build time) ---
# Shop name shown in header, footer and page titles
NEXT_PUBLIC_BRAND_NAME=TopSaver
# Colour preset: classic | ocean | emerald | sunset | royal | rose
THEME_PRESET=classic
# Optional per-colour overrides (hex only). Keys: black secondary secondary2 surface line red purple green success yellow pink
# THEME_OVERRIDES={"purple":"#0A84FF","green":"#CDEBFF"}
